---
/**
 * Footer component - Site footer with social links and legal info
 *
 * Features:
 * - Social links driven by siteConfig.socialLinks (all links shown)
 * - Contact email and feedback form link
 * - Legal disclaimers and license links
 * - Back to top button
 *
 * Dependencies:
 * - ../data/config.ts for site config
 * - CSS classes from public/css/styles.css (.footer, .social-links)
 */
import { getSiteConfigContent } from '../data/config';
import { tinaField } from '@tinacms/astro';

const currentYear = new Date().getFullYear();
const { siteConfig } = await getSiteConfigContent();

function getSocialLabel(link: { name: string; url: string }) {
    const lowerName = link.name.toLowerCase();
    if (lowerName === 'instagram') {
        const match = link.url.match(/instagram\.com\/([^/?#]+)/);
        return match ? `@${match[1]}` : 'Instagram';
    }
    if (lowerName === 'linkedin') {
        const match = link.url.match(/linkedin\.com\/company\/([^/?#]+)/);
        return match ? match[1] : 'LinkedIn';
    }
    if (lowerName === 'linktree') {
        const match = link.url.match(/linktr\.ee\/([^/?#]+)/);
        return match ? `linktr.ee/${match[1]}` : 'Linktree';
    }
    if (lowerName === 'discord') {
        return 'Join our Discord';
    }
    return link.name;
}
---

<footer id="site-footer" class="footer no-print relative py-8 md:py-10 text-left bg-deep-purple dark:bg-[#0d0414] border-t border-bright-purple/20 transition-all duration-300">
    <div class="site-container mx-auto w-full max-w-[980px] px-5">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-[2fr_1fr] md:gap-16 text-center md:text-left">
            
            <!-- Left Column: Title & Disclaimer -->
            <div class="flex flex-col items-center md:items-start gap-4">
                <!-- Brand Logo -->
                <a href="/" class="inline-block flex-shrink-0" aria-label="DAISI Home">
                    <img 
                        src="/images/DAISI-logo.svg" 
                        alt="DAISI Logo" 
                        class="h-6 w-auto md:h-7 opacity-85 hover:opacity-100 transition-all duration-300" 
                        loading="lazy" 
                        decoding="async" 
                    />
                </a>
                <div class="text-base md:text-lg font-bold text-white tracking-wide" data-tina-field={tinaField(siteConfig._source, 'title')}>
                    {siteConfig.title}<sup class="text-[10px] md:text-xs font-normal text-white/50 ml-1.5 align-super">{currentYear}</sup>
                </div>
                {siteConfig.footerTagline && (
                    <p class="text-xs md:text-sm text-white/70 leading-relaxed font-normal" data-tina-field={tinaField(siteConfig._source, 'footerTagline')}>
                        {siteConfig.footerTagline}
                    </p>
                )}
                <!-- Disclaimer -->
                <p class="text-[11px] md:text-xs leading-relaxed text-white/50">
                    Durham AI Safety Initiative is a student group affiliated with Durham Students' Union, 
                    which is registered in England as a company limited by guarantee (07689815) and a charity (1145400). 
                    Durham Students' Union's registered office is Dunelm House, New Elvet, Durham, DH1 3AN.
                    Durham AI Safety Initiative follows Durham Students' Union's privacy policy and code of conduct.
                </p>
                <!-- Back to top button -->
                <a
                    href="#top"
                    id="back-to-top-link"
                    aria-label="Back to top"
                    class="mt-2 inline-flex items-center gap-2 text-xs text-white/50 hover:text-bright-purple hover:opacity-100 transition-colors"
                >
                    <i class="fas fa-arrow-up text-xs" aria-hidden="true"></i>
                    <span>Back to top</span>
                </a>
            </div>

            <!-- Right Column: Contact Us & Socials -->
            <div class="flex flex-col gap-4 items-center md:items-start">
                <span class="font-bold text-white text-[15px] uppercase tracking-wider opacity-85">
                    Contact Us
                </span>

                <!-- Email -->
                <a
                    href={`mailto:${siteConfig.email}`}
                    aria-label="Email"
                    class="flex items-center gap-3 text-xs md:text-sm text-white hover:text-bright-purple hover:opacity-100 transition-colors"
                    data-tina-field={tinaField(siteConfig._source, 'email')}
                >
                    <i class="fas fa-envelope text-base w-5 text-center flex-shrink-0" aria-hidden="true"></i>
                    <span>{siteConfig.email}</span>
                </a>

                <!-- Socials loops -->
                {siteConfig.socialLinks.map((link) => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noreferrer noopener"
                        aria-label={link.name}
                        class="flex items-center gap-3 text-xs md:text-sm text-white/80 hover:text-bright-purple hover:opacity-100 transition-colors"
                        data-tina-field={tinaField(link._source, 'url')}
                    >
                        <img
                            src={link.icon}
                            alt=""
                            class="w-5 h-5 invert brightness-0 flex-shrink-0 transition-all duration-300"
                        />
                        <span>{getSocialLabel(link)}</span>
                    </a>
                ))}
            </div>

        </div>

        <!-- Divider & Bottom Navigation Links -->
        <div class="border-t border-white/10 my-6"></div>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-[11px] md:text-xs text-white/40 font-medium">
            <!-- Report feedback -->
            <a
                href="https://docs.google.com/forms/d/e/1FAIpQLSd1e1H4DnI1xWvjtpO4pZCAQiUq1mtdYYiDnJUBHb8yb72xMQ/viewform?usp=dialog"
                target="_blank"
                rel="noreferrer noopener"
                aria-label="Send anonymous feedback / report an issue"
                class="flex items-center gap-2 hover:text-bright-purple transition-colors"
            >
                <i class="fas fa-user-secret" aria-hidden="true"></i>
                <span>Report feedback / issue</span>
            </a>

            <span aria-hidden="true" class="hidden sm:inline text-white/20">•</span>

            <!-- Open source link -->
            <a
                href={`https://github.com/${siteConfig.repository}`}
                target="_blank"
                rel="noreferrer noopener"
                aria-label="This site is open-source on GitHub"
                class="flex items-center gap-2 hover:text-bright-purple transition-colors"
            >
                <i class="fa-brands fa-github" aria-hidden="true"></i>
                <span>This site is open-source</span>
            </a>

            <span aria-hidden="true" class="hidden sm:inline text-white/20">•</span>

            <!-- Admin panel -->
            <a
                href="/admin/"
                aria-label="Admin panel"
                class="flex items-center gap-2 text-white/30 hover:text-bright-purple transition-colors"
            >
                <i class="fa-solid fa-wrench opacity-70" aria-hidden="true"></i>
                <span>Admin Panel</span>
            </a>
        </div>
    </div>
</footer>
