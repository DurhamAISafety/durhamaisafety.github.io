---
import Icon from '../Icon.astro';
import type { GetInvolvedCard } from "../../data/get-involved";

interface Props {
  featuredCards: GetInvolvedCard[];
  moreCards: GetInvolvedCard[];
}

const { featuredCards, moreCards } = Astro.props;
---

{/* Featured / Recommended Cards */}
{featuredCards.length > 0 && (
  <section class="section section-light">
    <div class="site-container">
      <div class={`grid grid-cols-1 gap-8 max-w-4xl mx-auto mb-12 ${
        featuredCards.length === 1
          ? 'md:grid-cols-1 max-w-sm'
          : featuredCards.length === 2
          ? 'md:grid-cols-2'
          : 'md:grid-cols-3'
      }`}>
        {featuredCards.map((card, i) => {
          const borderClasses = ['border-bright-purple-50', 'border-light-purple-50', 'border-lavender-50'];
          const borderClass = borderClasses[i % borderClasses.length];
          return (
            <div class={`involvement-card card p-6 card-hover text-center border-strong flex flex-col h-full ${borderClass}`}>
              <Icon name={card.icon} class="text-5xl text-durham-purple mb-4 self-center" />
              <h2 class="text-xl font-bold mb-4">
                {card.title}
              </h2>
              <p class="text-base leading-relaxed mb-4 flex-grow">
                {card.description}
              </p>
              <a
                href={card.link_url}
                class="btn btn-primary btn-sm mt-auto"
                {...(card.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {card.link_label}
                {card.external && <Icon name="fas fa-external-link-alt" class="ml-1 text-xs" />}
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

{/* More Ways to Get Involved */}
{moreCards.length > 0 && (
  <section class="section section-neutral">
    <div class="site-container">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold mb-4">More Ways to Get Involved</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {moreCards.map((card) => (
          <div class="involvement-card card p-6 card-hover text-center flex flex-col h-full">
            <Icon name={card.icon} class="text-5xl text-durham-purple mb-4 self-center" />
            {card.badge && (
              <span class="self-center px-2 py-0.5 mb-2 text-xs font-medium rounded-full bg-surface-muted text-body-text">
                {card.badge}
              </span>
            )}
            <h3 class="text-xl font-bold mb-4">
              {card.title}
            </h3>
            <p class="text-base leading-relaxed mb-4 flex-grow">
              {card.description}
            </p>
            <a
              href={card.link_url}
              class="btn btn-secondary btn-sm hover:underline transition-all duration-200 mt-auto"
              {...(card.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {card.link_label}
              {card.external && <Icon name="fas fa-external-link-alt" class="ml-1 text-xs" />}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
