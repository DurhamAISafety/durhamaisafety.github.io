---
import ResearchCard from '../ResearchCard.astro';
import type { ResearchPaper } from '../../data/research';
import type { HomePageConfig } from '../../data/config';

interface Props {
  homeConfig: HomePageConfig;
  research: ResearchPaper[];
}

const { homeConfig, research } = Astro.props;
---

<section id="research" class="py-16 section-neutral">
    <div class="site-container mx-auto px-6">
        <div class="text-center mb-16 reveal">
            <h2 class="section-heading text-4xl md:text-5xl mb-6">{homeConfig.researchTitle}</h2>
            <div class="w-24 h-1 bg-bright-purple mx-auto rounded-full mb-8"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal">
            {research.slice(0, 4).map((paper) => (
                <ResearchCard paper={paper} thumbnailImage={paper.thumbnail} />
            ))}
        </div>
        <div class="text-center mt-12 reveal" style="--reveal-delay: 150ms">
            <a href="/research" class="btn-cta mb-12">{homeConfig.researchViewAllText}</a>
        </div>
    </div>
</section>
