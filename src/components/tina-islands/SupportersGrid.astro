---
import { tinaField } from '@tinacms/astro';
import type { Supporter } from '../../data/supporters';

interface Props {
  supporters: Supporter[];
}

const { supporters } = Astro.props;

const supporterLogoSrc = (logo: string): string =>
  logo.startsWith('/images/') ? logo : `/images/supporters/${logo}`;
---

<section id="supported-by" class="py-16 section-neutral">
  <div class="site-container mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <h2 class="section-heading text-4xl md:text-5xl mb-6">Proudly Supported By</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-bright-purple to-light-purple mx-auto rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
      {supporters.map((supporter, i) => (
        <a
          href={supporter.link}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center group reveal"
          style={`--reveal-delay: ${i * 80}ms`}
          data-tina-field={tinaField(supporter._source, 'link')}
        >
          <div class="involvement-card rounded-xl p-4 mb-3 transition-transform group-hover:scale-105 h-24 w-24 flex items-center justify-center">
            <img
              src={supporterLogoSrc(supporter.logo)}
              alt={`${supporter.name} logo`}
              class="max-h-16 max-w-16 object-contain"
              data-tina-field={tinaField(supporter._source, 'logo')}
            />
          </div>
          <div class="text-center min-h-[3rem] flex flex-col justify-start">
            <span
              class="text-base md:text-lg font-semibold"
              data-tina-field={tinaField(supporter._source, 'name')}
            >
              {supporter.name}
            </span>
            {supporter.subtitle && (
              <span
                class="text-sm text-muted-text"
                data-tina-field={tinaField(supporter._source, 'subtitle')}
              >
                {supporter.subtitle}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
