---
import { tinaField } from '@tinacms/astro';
import type { Supporter } from '../../data/supporters';

interface Props {
  supporters: Supporter[];
}

const { supporters } = Astro.props;

const supporterLogoSrc = (logo: string): string =>
  logo.startsWith('/images/') ? logo : `/images/supporters/${logo}`;
---

<section class="w-full bg-surface-muted dark:bg-[#141428] border-y border-slate-200 dark:border-white/5 py-8 reveal">
  <div class="site-container mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <p class="text-muted-text dark:text-white/40 text-xs uppercase tracking-widest font-semibold text-center md:text-left flex-shrink-0">
      Proudly supported by
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
      {supporters.map((supporter) => (
        <a
          href={supporter.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit supporter website"
          class="supporter-btn flex items-center justify-center bg-white dark:bg-white/95 hover:bg-white rounded-xl px-4 py-2.5 shadow-sm border border-slate-100 dark:border-transparent transition-all duration-300"
          data-tina-field={tinaField(supporter._source, 'link')}
        >
          <img
            src={supporterLogoSrc(supporter.logo)}
            alt="Supporter Logo"
            class="supporter-logo h-7 md:h-8 max-w-[110px] md:max-w-[130px] object-contain flex-shrink-0"
            data-tina-field={tinaField(supporter._source, 'logo')}
          />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.supporter-btn {
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
}

.supporter-btn:hover,
.supporter-btn:focus-visible {
    transform: scale(1.05);
    box-shadow: 0 10px 20px -5px rgba(235, 128, 253, 0.15), 0 6px 6px -6px rgba(235, 128, 253, 0.15);
    border-color: var(--color-bright-purple, #EB80FD);
}
</style>
