---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getActiveAnnouncement } from '../data/announcement';
import { getSiteConfigContent } from '../data/config';
import '../styles/global.css';


export interface Props {
  title?: string;
  description?: string;
  heroImage?: string;
}

const { title, description, heroImage } = Astro.props;

const { siteConfig } = await getSiteConfigContent();
const announcement = getActiveAnnouncement();

const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={siteConfig.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <link rel="canonical" href={canonicalURL}>
    
    <!-- Organization Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": `${siteConfig.url}/#org`,
      "name": siteConfig.title,
      "url": siteConfig.url,
      "sameAs": siteConfig.socialLinks.map(s => s.url).filter(Boolean),
      "contactPoint": [{
        "@type": "ContactPoint",
        "email": siteConfig.email,
        "contactType": "customer service"
      }]
    })}></script>

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/images/DAISI-logo.svg">
    <link rel="shortcut icon" href="/images/new_favicon/favicon.ico">
    <link rel="icon" type="image/x-icon" href="/images/new_favicon/favicon.ico">
    <link rel="mask-icon" href="/images/logo-monochrome.svg" color="#39144F">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/new_favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/new_favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/new_favicon/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#39144F">
    <meta name="google-site-verification" content={siteConfig.googleSiteVerification}>
    
    <!-- Self-hosted fonts (astro.config.mjs `fonts`) -->
    <Font cssVariable="--font-raleway" />
    <Font cssVariable="--font-merriweather" />
    


    {heroImage && (
      <link rel="preload" as="image" href={heroImage} imagesrcset={`${heroImage} 1200w`} imagesizes="100vw">
    )}
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDescription}>
    <meta property="og:site_name" content={siteConfig.title}>
    <meta property="og:locale" content={siteConfig.lang.replace('_', '-')}>
    <meta property="og:image" content={heroImage ? new URL(heroImage, siteConfig.url).href : new URL(siteConfig.ogImage, siteConfig.url).href}>
    {!heroImage && <meta property="og:image:width" content="1280">}
    {!heroImage && <meta property="og:image:height" content="640">}
    <meta property="og:image:alt" content={pageDescription}>
    
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={pageDescription}>
    <meta name="twitter:image" content={heroImage ? new URL(heroImage, siteConfig.url).href : new URL(siteConfig.ogImage, siteConfig.url).href}>
    <meta name="twitter:image:alt" content={pageDescription}>

  <!-- Apply theme before first paint to prevent flash of wrong theme -->
  <script is:inline>
    (function () {
      let stored = null;
      try { stored = localStorage.getItem('theme'); } catch (_) {}
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
      // Mark JS as active for progressive-enhancement CSS hooks (e.g. .reveal)
      // Skip hiding elements inside CMS preview / iframes to avoid loading visibility issues
      if (window.parent === window) {
        document.documentElement.classList.add('js-enabled');
      }
    })();
  </script>

  <slot name="head" />
</head>
<body class="font-body min-h-screen">
  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="skip-to-content">
    Skip to main content
  </a>
  <!-- Anchor target for footer's Back to top link -->
  <div id="top" aria-hidden="true"></div>
    {announcement && (
      <aside class="announcement-bar no-print" aria-label="Announcement">
        <div class="site-container">
          <Icon name="fas fa-bullhorn" class="mr-2" />
          <span set:html={announcement.messageHtml} />
          {announcement.link_url && announcement.link_label && (
            <a
              href={announcement.link_url}
              class="ml-2 font-semibold whitespace-nowrap"
              {...(announcement.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {announcement.link_label}
              <Icon name={announcement.external ? 'fas fa-external-link-alt' : 'fas fa-arrow-right'} class="ml-1 text-xs" />
            </a>
          )}
        </div>
      </aside>
    )}
    <Header />
    
    <main id="main-content">
        <slot />
    </main>
    
    <Footer />
    
  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
