---
import Layout from '../../layouts/Layout.astro';
import { getProgrammesContent, programmeSlug, renderMarkdown } from '../../data/programmes';
import { getSiteConfigContent } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const { programmes } = await getProgrammesContent();
  return programmes.map(programme => ({
    params: { slug: programmeSlug(programme.title) },
    props: { programme }
  }));
}

const { programme } = Astro.props;
const { siteConfig } = await getSiteConfigContent();
const slug = programmeSlug(programme.title);

const hasWhos = programme.whos_this_for && programme.whos_this_for.length > 0;
const hasBoxes = programme.feature_boxes?.items && programme.feature_boxes.items.length > 0;
const boxCount = programme.feature_boxes?.items?.length ?? 0;
const boxGridClass = boxCount === 1
  ? 'grid-cols-1 max-w-sm mx-auto'
  : boxCount === 2
  ? 'md:grid-cols-2'
  : 'md:grid-cols-3';
---

<Layout
  title={`${programme.title} | Programmes`}
  description={programme.short_description}
>
  <!-- Programme Hero -->
  {programme.image ? (
    <section class="relative min-h-[55vh] flex items-end overflow-hidden border-b border-white/5">
      <img
        src={programme.image}
        alt={`${programme.title} at DAISI`}
        class="absolute inset-0 w-full h-full object-cover"
        style={`view-transition-name: prog-${slug}`}
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/30"></div>

      <a
        href="/#programmes"
        class="absolute top-6 left-6 z-20 inline-flex items-center gap-2 text-sm text-white/90 hover:text-white font-semibold bg-black/30 backdrop-blur px-3 py-1.5 rounded-full transition-colors duration-200"
      >
        <i class="fa-solid fa-arrow-left text-xs"></i> Back to What we do
      </a>

      <div class="site-container mx-auto px-6 relative z-10 w-full text-center pt-24 pb-12">
        <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white drop-shadow-lg reveal">{programme.title}</h1>
        <div class="w-24 h-1 bg-bright-purple mx-auto rounded-full mb-6"></div>

        {programme.tags && programme.tags.length > 0 && (
          <div class="flex flex-wrap items-center justify-center gap-3 reveal">
            {programme.tags.map(tag => (
              <div class="flex items-center gap-1.5 bg-white/15 border border-white/25 backdrop-blur px-3 py-1 rounded-full text-sm">
                <i class={`${tag.icon} text-white`} aria-hidden="true"></i>
                <span class="font-semibold text-white">{tag.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ) : (
    <section class="py-16 md:py-24 section-neutral relative overflow-hidden border-b border-white/5">
      <div class="absolute -right-40 -top-40 w-96 h-96 bg-bright-purple/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="site-container mx-auto px-6 text-center relative z-10">
        <a href="/#programmes" class="inline-flex items-center gap-2 text-sm text-durham-purple hover:text-bright-purple font-semibold mb-8 transition-colors duration-200">
          <i class="fa-solid fa-arrow-left text-xs"></i> Back to What we do
        </a>
        <div class="mb-6 reveal">
          <i class={`${programme.icon} text-6xl text-durham-purple`} aria-hidden="true"></i>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 reveal">{programme.title}</h1>
        <div class="w-24 h-1 bg-bright-purple mx-auto rounded-full mb-6"></div>

        {programme.tags && programme.tags.length > 0 && (
          <div class="flex flex-wrap items-center justify-center gap-3 mt-4 reveal">
            {programme.tags.map(tag => (
              <div class="flex items-center gap-1.5 bg-bright-purple/15 border border-bright-purple/30 px-3 py-1 rounded-full text-sm">
                <i class={`${tag.icon} text-durham-purple`} aria-hidden="true"></i>
                <span class="font-semibold text-body-text">{tag.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Overview & Audience -->
  <section class="py-16 section-light border-b border-white/5">
    <div class="site-container mx-auto px-6">
      <div class="max-w-5xl mx-auto">
        <div class={`grid gap-12 items-start ${programme.long_description && hasWhos ? 'grid-cols-1 lg:grid-cols-[1.5fr_1fr]' : 'grid-cols-1'}`}>
          {programme.long_description && (
            <div class="reveal">
              <h2 class="text-2xl font-bold text-heading-text mb-6">Programme Overview</h2>
              <div
                class="prose prose-purple dark:prose-invert max-w-none text-body-text"
                set:html={renderMarkdown(programme.long_description)}
              />
            </div>
          )}

          {hasWhos && (
            <div class="bg-white/5 border border-bright-purple/20 backdrop-blur rounded-2xl p-8 reveal" style="--reveal-delay: 150ms">
              <h2 class="text-xl font-bold text-heading-text mb-6 flex items-center gap-2">
                <i class="fa-solid fa-users text-durham-purple"></i> Who is this for?
              </h2>
              <ul class="space-y-4">
                {programme.whos_this_for!.map(item => (
                  <li class="flex items-start gap-3 text-body-text">
                    <i
                      class={`${item.icon || 'fas fa-check'} text-durham-purple mt-1 flex-shrink-0 text-sm`}
                      aria-hidden="true"
                    ></i>
                    <span>{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Boxes / Modules -->
  {hasBoxes && (
    <section class="py-16 section-neutral border-b border-white/5">
      <div class="site-container mx-auto px-6">
        <div class="max-w-5xl mx-auto">
          {programme.feature_boxes!.heading && (
            <h2
              class="text-2xl font-bold text-heading-text mb-8 text-center reveal"
            >
              {programme.feature_boxes!.heading}
            </h2>
          )}
          
          <div class={`grid gap-6 ${boxGridClass}`}>
            {programme.feature_boxes!.items.map((box, i) => (
              <div
                class="bg-white/5 backdrop-blur rounded-xl p-6 text-center border border-white/10 hover:border-bright-purple/20 shadow-md transition-all duration-300 reveal flex flex-col h-full"
                style={`--reveal-delay: ${i * 100}ms`}
              >
                <i class={`${box.icon} text-3xl text-durham-purple mb-4 block`} aria-hidden="true"></i>
                <h3
                  class="text-lg font-bold mb-3 text-heading-text"
                >
                  {box.title}
                </h3>
                <p
                  class="text-sm text-body-text leading-relaxed flex-grow"
                >
                  {box.description}
                </p>
                {box.link && (
                  <a
                    href={box.link}
                    target={box.link.startsWith('http') ? '_blank' : undefined}
                    rel={box.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center justify-center gap-1.5 mt-5 text-sm font-semibold text-bright-purple hover:underline transition-all duration-200"
                  >
                    {box.link_label ?? 'Learn more'}
                    {box.link.startsWith('http') && (
                      <i class="fas fa-external-link-alt text-xs" aria-hidden="true"></i>
                    )}
                    {!box.link.startsWith('http') && (
                      <i class="fas fa-file-pdf text-xs" aria-hidden="true"></i>
                    )}
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Programme CTA -->
  <section class="py-16 section-neutral border-b border-white/5 text-center">
    <div class="site-container mx-auto px-6 max-w-2xl reveal">
      {programme.cta === 'email' ? (
        <>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Want to get involved?</h2>
          <p class="text-body-text mb-8">
            Tell us what you're working on — we'd love to help. Students: include your CV and a brief note on your interest in AI safety research.
          </p>
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex items-center gap-2 px-6 py-3 bg-durham-purple text-white font-medium rounded-lg hover:bg-[#7a2d80] transition-colors duration-200"
          >
            <i class="fa-solid fa-envelope" aria-hidden="true"></i> Email us
          </a>
        </>
      ) : (
        <>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Don't miss the next one</h2>
          <p class="text-body-text mb-8">
            Follow our news for announcements, and subscribe to our events calendar to see what's coming up.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a
              href="/news/"
              class="inline-flex items-center gap-2 px-6 py-3 bg-durham-purple text-white font-medium rounded-lg hover:bg-[#7a2d80] transition-colors duration-200"
            >
              <i class="fa-solid fa-newspaper" aria-hidden="true"></i> Follow our news
            </a>
            <a
              href={`https://luma.com/${siteConfig.calendar.lumaCalendarSlug}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-heading-text font-medium rounded-lg hover:bg-white/5 transition-colors duration-200"
            >
              <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Subscribe to calendar
            </a>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-16 section-light text-center">
    <div class="site-container mx-auto px-6 reveal">
      <h2 class="text-xl font-bold mb-4">Interested in other opportunities?</h2>
      <p class="text-muted-text mb-8 max-w-md mx-auto">Explore our other programmes and our calendar of events.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/#programmes" class="px-6 py-3 bg-durham-purple text-white font-medium rounded-lg hover:bg-[#7a2d80] transition-colors duration-200">
          View all programmes
        </a>
        <a href="/get-involved/" class="px-6 py-3 border border-white/20 text-heading-text font-medium rounded-lg hover:bg-white/5 transition-colors duration-200">
          Get Involved
        </a>
      </div>
    </div>
  </section>
</Layout>
