---
import Layout from "../layouts/Layout.astro";
import GetInvolvedPageIsland from "../components/islands/GetInvolvedPageIsland.astro";
import { getGetInvolvedContent } from "../data/get-involved";

const { featuredCards, moreCards } = await getGetInvolvedContent();
---

<Layout 
  title="Get Involved"
  description="Join Durham AI Safety Initiative: attend events, join our Discord, start a research project, and connect with our community."
>
  <section class="section section-neutral">
    <div class="site-container text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Get Involved</h1>
        <div class="w-24 h-1 bg-gradient-to-r from-bright-purple to-light-purple mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-body-text max-w-2xl mx-auto">
          Everyone's welcome — you don't need to be a Durham student or know anything about AI safety yet. New here? Start below with our Discord and an event.
        </p>
    </div>
  </section>

  <GetInvolvedPageIsland featuredCards={featuredCards} moreCards={moreCards} />
</Layout>
