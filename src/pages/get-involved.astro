---
import Layout from "../layouts/Layout.astro";
import GetInvolvedPageIsland from "../components/tina-islands/GetInvolvedPageIsland.astro";
import { getGetInvolvedContent } from "../data/get-involved";

const { featuredCards, moreCards } = await getGetInvolvedContent();
---

<Layout 
  title="Get Involved"
  description="Join Durham AI Safety Initiative: attend events, join our Discord, start a research project, and connect with our community."
>
  <section class="section section-neutral">
    <div class="site-container text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Get Involved</h1>
        <div class="w-24 h-1 bg-gradient-to-r from-bright-purple to-light-purple mx-auto rounded-full"></div>
    </div>
  </section>

  <div class="contents" data-tina-island="/tina-island/get-involved">
    <GetInvolvedPageIsland featuredCards={featuredCards} moreCards={moreCards} />
  </div>
</Layout>
