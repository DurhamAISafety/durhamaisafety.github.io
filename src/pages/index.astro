---
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/hero-picture.webp';
import { getResearchContent } from '../data/research';
import { getSupportersContent } from '../data/supporters';
import { getProgrammesContent } from '../data/programmes';
import { getSiteConfigContent, getHomePageContent } from '../data/config';

import HeroSection from '../components/sections/HeroSection.astro';
import EventsSection from '../components/sections/EventsSection.astro';
import ProgrammePreviewSection from '../components/sections/ProgrammePreviewSection.astro';
import ResearchPreviewSection from '../components/sections/ResearchPreviewSection.astro';
import SupportersHeroStrip from '../components/islands/SupportersHeroStrip.astro';

const { programmes } = await getProgrammesContent();
const { research } = await getResearchContent();
const { supporters } = await getSupportersContent();
const { siteConfig } = await getSiteConfigContent();
const { homeConfig } = await getHomePageContent();
---

<Layout 
  description="Durham AI Safety Initiative (DAISI) at Durham University: events, research and community focused on reducing catastrophic risks from advanced AI."
  heroImage={heroImage.src}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Durham AI Safety Initiative",
      "alternateName": "DAISI",
      "url": "https://durhamaisafety.uk",
      "description": "Student-led initiative at Durham University focused on reducing catastrophic risks from advanced AI through education, research, and community building.",
      "foundingLocation": {
        "@type": "Place",
        "name": "Durham University",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Durham",
          "addressCountry": "UK"
        }
      },
      "areaServed": "Durham University",
      "memberOf": {
        "@type": "EducationalOrganization",
        "name": "Durham University"
      }
    })}
  />

  <HeroSection
    homeConfig={homeConfig}
    heroImage={heroImage}
  />

  <SupportersHeroStrip supporters={supporters} />

  <!-- What is AI Safety? (folded in from the former standalone page) -->
  <section id="what-is-ai-safety" class="py-12 section-neutral">
    <div class="site-container mx-auto px-6">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8 md:gap-10 items-center reveal">
        <div class="text-center md:text-left">
          <h2 class="section-heading text-2xl md:text-3xl mb-4">What is AI Safety?</h2>
          <p class="text-lg leading-relaxed">
            <span class="text-bright-purple font-semibold">&ldquo;AI Safety&rdquo;</span> means keeping artificial intelligence from causing harm. We focus on the most catastrophic risks, up to and including human extinction, because we believe AI capabilities are advancing fast enough to make them real. <a href="https://80000hours.org/problem-profiles/risks-from-power-seeking-ai/" target="_blank" rel="noopener noreferrer" class="text-bright-purple hover:text-light-purple underline font-medium">Find out more</a>.
          </p>
        </div>
        <div class="aspect-video w-full max-w-xl mx-auto md:mx-0 rounded-2xl overflow-hidden shadow-lg">
          <iframe
            class="w-full h-full"
            src="https://www.youtube.com/embed/5KVDDfAkRgc"
            title="What is AI safety?"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <EventsSection
    homeConfig={homeConfig}
    siteConfig={siteConfig}
  />

  <ProgrammePreviewSection
    homeConfig={homeConfig}
    programmes={programmes}
  />

  <!-- Post-event community note -->
  <section class="pt-0 pb-12 section-light border-b border-white/5">
    <div class="site-container mx-auto px-6">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8 items-center reveal">
        <div class="rounded-2xl overflow-hidden shadow-lg border border-durham-purple/20">
          <img
            src="/images/community/post-event-pizza.webp"
            alt="Pizza laid out after a DAISI event"
            class="w-full h-56 md:h-64 object-cover"
            width="1536"
            height="1536"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="text-center md:text-left">
          <h2 class="section-heading text-2xl md:text-3xl mb-3">Free pizza after almost every event</h2>
        </div>
      </div>
    </div>
  </section>

  <ResearchPreviewSection
    homeConfig={homeConfig}
    research={research}
  />
</Layout>

<script>
    // Parallax effect for hero image
    const parallaxContainer = document.querySelector('.hero-parallax-container');
    const heroSection = document.querySelector('.hero-section');
    
    if (parallaxContainer && heroSection) {
        // Only enable on desktop with fine pointer (mouse)
        const isDesktop = window.matchMedia('(min-width: 768px) and (hover: hover) and (pointer: fine)').matches;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (isDesktop && !prefersReducedMotion) {
            let ticking = false;
            
            const updateParallax = () => {
                const scrolled = window.scrollY;
                const heroHeight = (heroSection as HTMLElement).offsetHeight;
                
                // Only apply parallax while hero is visible
                if (scrolled < heroHeight * 1.5) {
                    // Move at 40% of scroll speed for subtle effect
                    const yPos = scrolled * 0.4;
                    (parallaxContainer as HTMLElement).style.transform = `translate3d(0, ${yPos}px, 0)`;
                }
                ticking = false;
            };
            
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    requestAnimationFrame(updateParallax);
                    ticking = true;
                }
            }, { passive: true });
        }
    }
</script>
