---
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/hero-picture.jpeg';
import { getResearchContent } from '../data/research';
import { getSupportersContent } from '../data/supporters';
import { getProgrammesContent } from '../data/programmes';
import { getSiteConfigContent, getHomePageContent } from '../data/config';

import HeroSection from '../components/sections/HeroSection.astro';
import EventsSection from '../components/sections/EventsSection.astro';
import ProgrammePreviewSection from '../components/sections/ProgrammePreviewSection.astro';
import ResearchPreviewSection from '../components/sections/ResearchPreviewSection.astro';
import SupportersHeroStrip from '../components/tina-islands/SupportersHeroStrip.astro';

const { programmes } = await getProgrammesContent();
const { research } = await getResearchContent();
const { supporters } = await getSupportersContent();
const { siteConfig } = await getSiteConfigContent();
const { homeConfig } = await getHomePageContent();
---

<Layout 
  description="Durham AI Safety Initiative (DAISI) at Durham University: events, research and community focused on reducing catastrophic risks from advanced AI."
  heroImage={heroImage.src}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Durham AI Safety Initiative",
      "alternateName": "DAISI",
      "url": "https://durhamaisafety.uk",
      "description": "Student-led initiative at Durham University focused on reducing catastrophic risks from advanced AI through education, research, and community building.",
      "foundingLocation": {
        "@type": "Place",
        "name": "Durham University",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Durham",
          "addressCountry": "UK"
        }
      },
      "areaServed": "Durham University",
      "memberOf": {
        "@type": "EducationalOrganization",
        "name": "Durham University"
      }
    })}
  />

  <HeroSection
    homeConfig={homeConfig}
    heroImage={heroImage}
  />

  <!-- Scroll indicator -->
  <a href="#what-is-ai-safety" aria-label="Scroll to introduction" class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1 text-white/60 hover:text-white transition-colors duration-200">
      <span class="text-xs uppercase tracking-widest font-medium">Scroll</span>
      <i class="fa-solid fa-chevron-down text-lg animate-bounce"></i>
  </a>

  <SupportersHeroStrip supporters={supporters} />

  <!-- What is AI Safety? (folded in from the former standalone page) -->
  <section id="what-is-ai-safety" class="py-16 section-neutral">
    <div class="site-container mx-auto px-6">
      <div class="text-center mb-10 reveal">
        <h2 class="section-heading text-4xl md:text-5xl mb-6">What is AI Safety?</h2>
        <div class="w-24 h-1 bg-bright-purple mx-auto rounded-full"></div>
      </div>
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xl md:text-2xl leading-relaxed mb-8 reveal">
          AI Safety is the field focused on ensuring that artificial intelligence systems are
          <span class="text-bright-purple font-bold"> safe, beneficial, and aligned with human values</span>
          as they become increasingly capable.
        </p>
        <div class="aspect-video max-w-2xl mx-auto mb-8 rounded-2xl overflow-hidden shadow-lg reveal">
          <iframe
            class="w-full h-full"
            src="https://www.youtube.com/embed/5KVDDfAkRgc"
            title="What is AI safety?"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <a
          href="https://80000hours.org/problem-profiles/risks-from-power-seeking-ai/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta reveal"
        >Find out more</a>
      </div>
    </div>
  </section>

  <EventsSection
    homeConfig={homeConfig}
    siteConfig={siteConfig}
  />

  <ProgrammePreviewSection
    homeConfig={homeConfig}
    programmes={programmes}
  />

  <ResearchPreviewSection
    homeConfig={homeConfig}
    research={research}
  />
</Layout>

<script>
    // Parallax effect for hero image
    const parallaxContainer = document.querySelector('.hero-parallax-container');
    const heroSection = document.querySelector('.hero-section');
    
    if (parallaxContainer && heroSection) {
        // Only enable on desktop with fine pointer (mouse)
        const isDesktop = window.matchMedia('(min-width: 768px) and (hover: hover) and (pointer: fine)').matches;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (isDesktop && !prefersReducedMotion) {
            let ticking = false;
            
            const updateParallax = () => {
                const scrolled = window.scrollY;
                const heroHeight = (heroSection as HTMLElement).offsetHeight;
                
                // Only apply parallax while hero is visible
                if (scrolled < heroHeight * 1.5) {
                    // Move at 40% of scroll speed for subtle effect
                    const yPos = scrolled * 0.4;
                    (parallaxContainer as HTMLElement).style.transform = `translate3d(0, ${yPos}px, 0)`;
                }
                ticking = false;
            };
            
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    requestAnimationFrame(updateParallax);
                    ticking = true;
                }
            }, { passive: true });
        }
    }
    
    // Fade scroll indicator on scroll
    const scrollIndicator = document.querySelector('.scroll-indicator');
    if (scrollIndicator) {
        window.addEventListener('scroll', () => {
            const opacity = Math.max(0, 1 - window.scrollY / 150);
            (scrollIndicator as HTMLElement).style.opacity = String(opacity);
        }, { passive: true });
    }
</script>
