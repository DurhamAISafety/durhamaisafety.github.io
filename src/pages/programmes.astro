---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Programmes"
  description="Our programmes now live on the home page under 'What we do'. Redirecting..."
>
  <meta slot="head" http-equiv="refresh" content="2;url=/#programmes" />

  <section class="py-32 section-neutral min-h-[60vh] flex items-center justify-center">
    <div class="site-container mx-auto px-6 text-center reveal">
      <i class="fa-solid fa-arrow-right-arrow-left text-5xl text-durham-purple mb-6 animate-pulse"></i>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">We've Moved!</h1>
      <div class="w-20 h-1 bg-bright-purple mx-auto rounded-full mb-6"></div>
      <p class="max-w-md mx-auto text-body-text mb-8">
        Our programmes now live on the home page under <strong>What we do</strong>.
      </p>
      <p class="text-sm text-muted-text">
        Redirecting you to <a href="/#programmes" class="text-durham-purple hover:underline font-semibold">What we do</a> in a moment...
      </p>
      <a
        href="/#programmes"
        class="inline-block mt-6 px-6 py-3 bg-durham-purple text-white font-medium rounded-lg hover:bg-[#7a2d80] transition-colors duration-200"
      >
        Go to What we do
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  // Fast redirection
  window.location.replace('/#programmes');
</script>
