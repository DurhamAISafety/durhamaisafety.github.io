---
import Layout from '../layouts/Layout.astro';
import ProgrammesPageIsland from '../components/tina-islands/ProgrammesPageIsland.astro';
import { getProgrammesContent } from '../data/programmes';

const { programmes } = await getProgrammesContent();
---

<Layout 
  title="Programmes"
  description="Explore DAISI programmes: intro AIS101 sessions, in-depth reading groups, research project support, and ways to develop AI safety skills."
>
  <div class="contents" data-tina-island="/tina-island/programmes">
    <ProgrammesPageIsland programmes={programmes} />
  </div>
</Layout>
