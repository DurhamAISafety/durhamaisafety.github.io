---
import Layout from "../layouts/Layout.astro";
import { getResearchContent } from "../data/research";
import { getResearchPageContent } from "../data/config";
import { tinaField } from "@tinacms/astro";
import ResearchPageIsland from "../components/tina-islands/ResearchPageIsland.astro";
import JumpNav from "../components/JumpNav.astro";

const { academicPapers, nonAcademicPapers } = await getResearchContent();
const { document, researchConfig } = await getResearchPageContent();
const doc = document.research!;

const page = {
  title: "Research",
  description: "Research by DAISI Members",
};
---

<Layout title={page.title} description={page.description}>
  <section class="section section-neutral">
    <div class="site-container text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Research</h1>
      <div class="w-24 h-1 bg-bright-purple mx-auto rounded-full mb-8"></div>
      
      <JumpNav links={[
        { href: '#recent-research', label: 'Recent Research', icon: 'fas fa-file-alt' },
        { href: '#opportunities', label: 'Opportunities', icon: 'fas fa-door-open' },
        { href: '#research-areas', label: 'Research Areas', icon: 'fas fa-flask' }
      ]} />
    </div>
  </section>

  <div class="contents" data-tina-island="/tina-island/research">
    <ResearchPageIsland academicPapers={academicPapers} nonAcademicPapers={nonAcademicPapers} />
  </div>

  {/* Research Opportunities */}
  <section id="opportunities" class="section section-neutral">
    <div class="site-container">
      <div class="text-center mb-12">
        <h3 class="section-heading text-3xl md:text-4xl mb-6" data-tina-field={tinaField(doc, 'opportunitiesTitle')}>{researchConfig.opportunitiesTitle}</h3>
        <div class="section-divider"></div>
      </div>
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {researchConfig.opportunities.map((opp) => (
            <div class="research-card rounded-2xl p-6 card-hover">
              <div class="flex items-center mb-4">
                <i class={`${opp.icon} text-3xl ${opp.iconColor} mr-4`} data-tina-field={tinaField(opp, 'icon')} aria-hidden="true"></i>
                <h4 class="text-lg font-bold" data-tina-field={tinaField(opp, 'title')}>{opp.title}</h4>
              </div>
              <p class="text-sm leading-relaxed" data-tina-field={tinaField(opp, 'description')}>{opp.description}</p>
            </div>
          ))}
        </div>
        <div class="text-center">
          <a href={researchConfig.opportunitiesCtaLink} class="btn-cta" data-tina-field={tinaField(doc, 'opportunitiesCtaText')}>{researchConfig.opportunitiesCtaText}</a>
        </div>
      </div>
    </div>
  </section>

  {/* Research Areas */}
  <section id="research-areas" class="section section-light">
    <div class="site-container">
      <div class="text-center mb-12">
        <h3 class="section-heading text-3xl md:text-4xl mb-6" data-tina-field={tinaField(doc, 'areasTitle')}>{researchConfig.areasTitle}</h3>
        <div class="section-divider"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {researchConfig.researchAreas.map((area) => (
          <div class="research-card rounded-2xl p-6 card-hover">
            <div class="text-center mb-4">
              <i class={`${area.icon} text-5xl ${area.iconColor}`} data-tina-field={tinaField(area, 'icon')} aria-hidden="true"></i>
            </div>
            <h4 class="text-xl font-bold text-center mb-4" data-tina-field={tinaField(area, 'title')}>{area.title}</h4>
            <p class="text-center text-sm leading-relaxed" data-tina-field={tinaField(area, 'description')}>{area.description}</p>
            <div class="text-center mt-3">
              <a href={area.linkUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-bright-purple hover:underline inline-flex items-center" data-tina-field={tinaField(area, 'linkUrl')}>
                Learn more <i class="fas fa-external-link-alt ml-1 text-xs" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
